{
  "name": "notification-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nestjs-services/notification-service/src",
  "projectType": "application",
  "implicitDependencies": [
    "shared-types",
    "database-client",
    "kafka-client",
    "utils"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "nest build",
        "cwd": "apps/nestjs-services/notification-service"
      },
      "configurations": {
        "production": { "command": "nest build" },
        "development": { "command": "nest build" }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": { "buildTarget": "notification-service:build", "port": 3008 },
      "configurations": {
        "production": { "buildTarget": "notification-service:build:production" },
        "development": { "buildTarget": "notification-service:build:development" },
        "debug": {
          "buildTarget": "notification-service:build:development",
          "inspect": true, "host": "0.0.0.0", "port": 9236, "watch": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "outputs": ["{options.outputFile}"],
      "options": { "lintFilePatterns": ["apps/nestjs-services/notification-service/**/*.ts"] }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/nestjs-services/notification-service"],
      "options": {
        "jestConfig": "apps/nestjs-services/notification-service/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": { "ci": { "ci": true, "codeCoverage": true } }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "push": false, "engine": "docker",
        "metadata": {
          "images": ["polydom/notification-service"],
          "load": true,
          "tags": ["type=sha,prefix=sha-", "type=ref,event=branch"]
        }
      }
    }
  },
  "tags": ["service", "nest"]
}
