{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "strictPropertyInitialization": false,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "isolatedModules": false,
    "paths": {
      "@polydom/shared-types": ["../../../libs/shared-types/dist/index.d.ts"],
      "@polydom/kafka-client": ["../../../libs/kafka-client/dist/index.d.ts"],
      "@polydom/nats-client": ["../../../libs/nats-client/dist/index.d.ts"],
      "@polydom/database-client": ["../../../libs/database-client/dist/index.d.ts"],
      "@polydom/elasticsearch-client": ["../../../libs/elasticsearch-client/dist/index.d.ts"],
      "@polydom/utils": ["../../../libs/utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.seed.ts"]
}
